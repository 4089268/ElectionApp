@inject IConfiguration Configuration
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string ActiveIf(string controllerName) => currentController == controllerName ? "active" : "";
    string RolActual = User.IsInRole("Administrador") ? "Administrador"
        : User.IsInRole("Capturista") ? "Capturista"
        : User.IsInRole("Consulta") ? "Consulta"
        : "";
}
<!doctype html>
<html lang="es" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>@ViewData["Title"] - ElectionApp</title>

    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/bootstrap/bootstrap.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/daterangepicker.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/fontawesome.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/footable.standalone.min.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/fullcalendar@5.2.0.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/jquery-jvectormap-2.0.5.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/jquery.mCustomScrollbar.min.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/leaflet.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/line-awesome.min.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/magnific-popup.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/MarkerCluster.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/MarkerCluster.Default.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/select2.min.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/slick.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/star-rating-svg.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/trumbowyg.min.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/wickedpicker.min.css">
    <link rel="stylesheet" href="~/theme/style.css">

    <link rel="icon" type="image/png" sizes="16x16" href="~/theme/img/favicon.png">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
</head>

<body class="layout-light side-menu">
    <div class="mobile-search">
        <form action="#" class="search-form" onsubmit="return false;">
            <img src="~/theme/img/svg/search.svg" alt="search" class="svg">
            <input class="form-control me-sm-2 box-shadow-none" type="search" placeholder="Buscar...">
        </form>
    </div>
    <div class="mobile-author-actions"></div>

    <header class="header-top">
        <nav class="navbar navbar-light">
            <div class="navbar-left">
                <div class="logo-area">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <img class="dark" src="~/theme/img/logo.png" alt="ElectionApp">
                        <img class="light" src="~/theme/img/logo.png" alt="ElectionApp">
                    </a>
                    <a href="#" class="sidebar-toggle">
                        <img class="svg" src="~/theme/img/svg/align-center-alt.svg" alt="menu"></a>
                </div>
            </div>
            <div class="navbar-right">
                <ul class="navbar-right__menu">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var nombreCampanaActual = Context.Session.GetString("NombreCampanaActual");
                        if (!string.IsNullOrEmpty(nombreCampanaActual))
                        {
                            <li class="nav-campana-actual d-flex align-items-center me-15">
                                <a asp-controller="Campanas" asp-action="Seleccionar" class="d-flex align-items-center text-dark" title="Cambiar de campaña" style="gap:6px;">
                                    <i class="uil uil-megaphone"></i>
                                    <span class="fw-500">@nombreCampanaActual</span>
                                    <i class="las la-angle-down fs-12"></i>
                                </a>
                            </li>
                        }
                        <li class="nav-author">
                            <div class="dropdown-custom">
                                <a href="javascript:;" class="nav-item-toggle">
                                    <img src="~/theme/img/author-nav.jpg" alt="" class="rounded-circle">
                                    <span class="nav-item__title">@User.Identity!.Name<i class="las la-angle-down nav-item__arrow"></i></span>
                                </a>
                                <div class="dropdown-parent-wrapper">
                                    <div class="dropdown-wrapper">
                                        <div class="nav-author__info">
                                            <div class="author-img">
                                                <img src="~/theme/img/author-nav.jpg" alt="" class="rounded-circle">
                                            </div>
                                            <div>
                                                <h6>@User.Identity!.Name</h6>
                                                <span>@RolActual</span>
                                            </div>
                                        </div>
                                        <div class="nav-author__options">
                                            <form asp-controller="Account" asp-action="Logout" method="post">
                                                <button type="submit" class="nav-author__signout border-0 bg-transparent w-100 text-start">
                                                    <i class="uil uil-sign-out-alt"></i> Cerrar sesión
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
                <div class="navbar-right__mobileAction d-md-none">
                    <a href="#" class="btn-search">
                        <img src="~/theme/img/svg/search.svg" alt="search" class="svg feather-search">
                        <img src="~/theme/img/svg/x.svg" alt="x" class="svg feather-x"></a>
                    <a href="#" class="btn-author-action">
                        <img class="svg" src="~/theme/img/svg/more-vertical.svg" alt="more"></a>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-content">

        <div class="sidebar-wrapper">
            <div class="sidebar sidebar-collapse" id="sidebar">
                <div class="sidebar__menu-group">
                    <ul class="sidebar_nav">
                        <li class="@ActiveIf("Home")">
                            <a asp-controller="Home" asp-action="Index">
                                <span class="nav-icon uil uil-create-dashboard"></span>
                                <span class="menu-text">Inicio</span>
                            </a>
                        </li>
                        <li class="menu-title mt-30">
                            <span>Campaña</span>
                        </li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="@ActiveIf("Campanas")">
                                <a asp-controller="Campanas" asp-action="Index">
                                    <span class="nav-icon uil uil-megaphone"></span>
                                    <span class="menu-text">Campañas</span>
                                </a>
                            </li>
                        }
                        <li class="@ActiveIf("Integrantes")">
                            <a asp-controller="Integrantes" asp-action="Index">
                                <span class="nav-icon uil uil-users-alt"></span>
                                <span class="menu-text">Integrantes</span>
                            </a>
                        </li>
                        <li class="@ActiveIf("Eventos")">
                            <a asp-controller="Eventos" asp-action="Index">
                                <span class="nav-icon uil uil-calendar-alt"></span>
                                <span class="menu-text">Eventos</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="menu-title mt-30">
                                <span>Sistema</span>
                            </li>
                            <li class="@ActiveIf("Usuarios")">
                                <a asp-controller="Usuarios" asp-action="Index">
                                    <span class="nav-icon uil uil-shield-check"></span>
                                    <span class="menu-text">Usuarios</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="contents">
            <div class="dm-page-content">
                <div class="container-fluid">
                    @if (TempData["Mensaje"] is string mensaje)
                    {
                        <div class="alert alert-success">@mensaje</div>
                    }
                    @RenderBody()
                </div>
            </div>
        </div>

    </main>

    <div id="overlayer">
        <div class="loader-overlay">
            <div class="dm-spin-dots spin-lg">
                <span class="spin-dot badge-dot dot-primary"></span>
                <span class="spin-dot badge-dot dot-primary"></span>
                <span class="spin-dot badge-dot dot-primary"></span>
                <span class="spin-dot badge-dot dot-primary"></span>
            </div>
        </div>
    </div>
    <div class="overlay-dark-sidebar"></div>
    <div class="customizer-overlay"></div>

    <script src="~/theme/assets/vendor_assets/js/jquery/jquery-3.5.1.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/jquery/jquery-ui.js"></script>
    <script src="~/theme/assets/vendor_assets/js/bootstrap/popper.js"></script>
    <script src="~/theme/assets/vendor_assets/js/bootstrap/bootstrap.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/moment/moment.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/accordion.js"></script>
    <script src="~/theme/assets/vendor_assets/js/apexcharts.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/autoComplete.js"></script>
    <script src="~/theme/assets/vendor_assets/js/Chart.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/daterangepicker.js"></script>
    <script src="~/theme/assets/vendor_assets/js/drawer.js"></script>
    <script src="~/theme/assets/vendor_assets/js/dynamicBadge.js"></script>
    <script src="~/theme/assets/vendor_assets/js/dynamicCheckbox.js"></script>
    <script src="~/theme/assets/vendor_assets/js/footable.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/fullcalendar@5.2.0.js"></script>
    <script src="~/theme/assets/vendor_assets/js/google-chart.js"></script>
    <script src="~/theme/assets/vendor_assets/js/jquery-jvectormap-2.0.5.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/jquery-jvectormap-world-mill-en.js"></script>
    <script src="~/theme/assets/vendor_assets/js/jquery.countdown.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/jquery.filterizr.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/jquery.magnific-popup.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/jquery.peity.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/jquery.star-rating-svg.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/leaflet.js"></script>
    <script src="~/theme/assets/vendor_assets/js/leaflet.markercluster.js"></script>
    <script src="~/theme/assets/vendor_assets/js/loader.js"></script>
    <script src="~/theme/assets/vendor_assets/js/message.js"></script>
    <script src="~/theme/assets/vendor_assets/js/moment.js"></script>
    <script src="~/theme/assets/vendor_assets/js/muuri.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/notification.js"></script>
    <script src="~/theme/assets/vendor_assets/js/popover.js"></script>
    <script src="~/theme/assets/vendor_assets/js/select2.full.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/slick.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/trumbowyg.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/wickedpicker.min.js"></script>
    <script src="~/theme/assets/theme_assets/js/apexmain.js"></script>
    <script src="~/theme/assets/theme_assets/js/charts.js"></script>
    <script src="~/theme/assets/theme_assets/js/drag-drop.js"></script>
    <script src="~/theme/assets/theme_assets/js/footable.js"></script>
    <script src="~/theme/assets/theme_assets/js/full-calendar.js"></script>
    <script src="~/theme/assets/theme_assets/js/icon-loader.js"></script>
    <script src="~/theme/assets/theme_assets/js/jvectormap-init.js"></script>
    <script>
        window.mapboxAccessToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["Mapbox:AccessToken"] ?? ""));
    </script>
    <script src="~/theme/assets/theme_assets/js/leaflet-init.js"></script>
    <script src="~/theme/assets/theme_assets/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
