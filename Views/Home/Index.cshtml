@{
    ViewData["Title"] = "Inicio";
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">Panel general</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xxl-4 col-sm-6 mb-25">
        <div class="ap-po-details ap-po-details--2 p-25 radius-xl d-flex justify-content-between">
            <div class="overview-content w-100">
                <div class="ap-po-details-content d-flex flex-wrap justify-content-between">
                    <div class="ap-po-details__titlebar">
                        <h1>@ViewBag.TotalIntegrantes</h1>
                        <p>Integrantes</p>
                    </div>
                    <div class="ap-po-details__icon-area">
                        <div class="svg-icon order-bg-opacity-info color-info">
                            <i class="uil uil-users-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-4 col-sm-6 mb-25">
        <div class="ap-po-details ap-po-details--2 p-25 radius-xl d-flex justify-content-between">
            <div class="overview-content w-100">
                <div class="ap-po-details-content d-flex flex-wrap justify-content-between">
                    <div class="ap-po-details__titlebar">
                        <h1>@ViewBag.TotalEventos</h1>
                        <p>Eventos</p>
                    </div>
                    <div class="ap-po-details__icon-area">
                        <div class="svg-icon order-bg-opacity-warning color-warning">
                            <i class="uil uil-calendar-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-4 col-sm-6 mb-25">
        <div class="ap-po-details ap-po-details--2 p-25 radius-xl d-flex justify-content-between">
            <div class="overview-content w-100">
                <div class="ap-po-details-content d-flex flex-wrap justify-content-between">
                    <div class="ap-po-details__titlebar">
                        <h1>@ViewBag.TotalCampanas</h1>
                        <p>Campañas</p>
                    </div>
                    <div class="ap-po-details__icon-area">
                        <div class="svg-icon order-bg-opacity-secondary color-secondary">
                            <i class="uil uil-megaphone"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mb-25">
        <div class="card h-100">
            <div class="card-header border-bottom-0 p-sm-20">
                <h5 class="fw-500">Resumen de gastos</h5>
            </div>
            <div class="card-body pt-0 px-20 pb-25">
                @{
                    decimal totalEstimado = ViewBag.TotalCostoEstimado;
                    decimal totalReal = ViewBag.TotalCostoReal;
                    decimal diferencia = totalReal - totalEstimado;
                    decimal totalApoyos = ViewBag.TotalGastosApoyo;
                    decimal totalGeneral = totalReal + totalApoyos;
                }
                <p class="fw-500 mb-10">Gastos de eventos</p>
                <dl class="row mb-0">
                    <dt class="col-sm-6">Costo estimado</dt>
                    <dd class="col-sm-6 text-sm-end">@totalEstimado.ToString("C2")</dd>

                    <dt class="col-sm-6">Registrado (real)</dt>
                    <dd class="col-sm-6 text-sm-end">@totalReal.ToString("C2")</dd>

                    <dt class="col-sm-6">Diferencia</dt>
                    <dd class="col-sm-6 text-sm-end @(diferencia > 0 ? "text-danger" : "text-success")">@diferencia.ToString("C2")</dd>
                </dl>

                <hr class="my-15" />

                <p class="fw-500 mb-10">Gastos de apoyos / donaciones</p>
                <div class="d-flex justify-content-between">
                    <span>Total otorgado</span>
                    <span>@totalApoyos.ToString("C2")</span>
                </div>

                <hr class="my-15" />

                <div class="d-flex justify-content-between fw-500">
                    <span>Total general de gastos</span>
                    <span>@totalGeneral.ToString("C2")</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-25">
        <div class="card h-100">
            <div class="card-header border-bottom-0 p-sm-20">
                <h5 class="fw-500">Resumen de simpatizantes</h5>
            </div>
            <div class="card-body pt-0 px-20 pb-25">
                @if (ViewBag.ResumenRoles.Count > 0)
                {
                    <dl class="row mb-0">
                        @foreach (var item in ViewBag.ResumenRoles)
                        {
                            <dt class="col-sm-8">@item.Rol</dt>
                            <dd class="col-sm-4 text-sm-end">@item.Total</dd>
                        }
                    </dl>
                    <hr class="my-15" />
                    <div class="d-flex justify-content-between fw-500">
                        <span>Total afiliados</span>
                        <span>@ViewBag.TotalAfiliados</span>
                    </div>
                }
                else
                {
                    <p class="mb-0">Todavía no hay integrantes afiliados a esta campaña.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card mb-20">
            <div class="card-header border-bottom-0 p-sm-20">
                <h5 class="fw-500">Próximos eventos</h5>
            </div>
            <div class="card-body pt-0 px-20 pb-25">
                <div id="calendario-eventos"></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <h5 class="fw-500 mb-15">Mapa de eventos</h5>
        @if ((int)ViewBag.EventosConMapa == 0)
        {
            <p class="mb-30">Todavía no hay eventos con ubicación geolocalizada.</p>
        }
        else
        {
            <div id="mapa-eventos" class="radius-xl mb-30" style="height: 75vh; min-height: 550px;"></div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var eventos = @Html.Raw(ViewBag.EventosCalendarioJson ?? "[]");
            var contenedor = document.getElementById('calendario-eventos');
            if (!contenedor) {
                return;
            }

            var calendario = new FullCalendar.Calendar(contenedor, {
                initialView: 'dayGridMonth',
                height: 'auto',
                headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,listMonth' },
                buttonText: { today: 'Hoy', month: 'Mes', list: 'Lista' },
                events: eventos
            });
            calendario.render();
        })();

        (function () {
            var eventos = @Html.Raw(ViewBag.EventosMapaJson ?? "[]");
            var contenedor = document.getElementById('mapa-eventos');
            if (!contenedor || !eventos.length) {
                return;
            }

            var mapa = L.map(contenedor).setView([eventos[0].lat, eventos[0].lng], 9);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: '&copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a> contributors'
            }).addTo(mapa);

            var grupo = L.featureGroup();
            eventos.forEach(function (ev) {
                var marcador = L.marker([ev.lat, ev.lng]).bindPopup(
                    '<strong>' + ev.descripcion + '</strong><br>' +
                    ev.fecha + ' ' + ev.hora + '<br>' +
                    (ev.lugar ? ev.lugar + '<br>' : '') +
                    ev.municipio + ', ' + ev.estado
                );
                marcador.addTo(mapa);
                grupo.addLayer(marcador);
            });

            if (eventos.length > 1) {
                mapa.fitBounds(grupo.getBounds().pad(0.2), { maxZoom: 10 });
            }
        })();
    </script>
}
