@model CatCampana
@{
    ViewData["Title"] = "Nueva campaña";
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">Nueva campaña</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-9">
        <div class="card mb-30">
            <div class="card-header border-bottom-0 p-sm-30">
                <h5 class="fw-500">Datos de la campaña</h5>
            </div>
            <div class="card-body pt-0 px-30 pb-35">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-15"></div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group mb-25">
                                <label asp-for="Descripcion"></label>
                                <input asp-for="Descripcion" class="form-control" required />
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Puesto"></label>
                                <input asp-for="Puesto" class="form-control" required />
                                <span asp-validation-for="Puesto" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="Politico"></label>
                                <input asp-for="Politico" class="form-control" required />
                                <span asp-validation-for="Politico" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group mb-25">
                                <label asp-for="Anio"></label>
                                <input asp-for="Anio" class="form-control" type="number" min="2000" max="2100" required />
                                <span asp-validation-for="Anio" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group mb-25">
                                <label asp-for="Mes"></label>
                                <select asp-for="Mes" class="form-control" required>
                                    <option value="">-- Selecciona --</option>
                                    <option value="1">Enero</option>
                                    <option value="2">Febrero</option>
                                    <option value="3">Marzo</option>
                                    <option value="4">Abril</option>
                                    <option value="5">Mayo</option>
                                    <option value="6">Junio</option>
                                    <option value="7">Julio</option>
                                    <option value="8">Agosto</option>
                                    <option value="9">Septiembre</option>
                                    <option value="10">Octubre</option>
                                    <option value="11">Noviembre</option>
                                    <option value="12">Diciembre</option>
                                </select>
                                <span asp-validation-for="Mes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="button-group d-flex pt-25">
                        <button type="submit" class="btn btn-primary btn-default btn-squared px-30 me-15">Guardar</button>
                        <a asp-action="Index" class="btn btn-light btn-default btn-squared px-30">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
