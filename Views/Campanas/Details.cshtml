@model CatCampana
@{
    ViewData["Title"] = "Detalle de la campaña";
    string[] meses = { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">@Model.Descripcion</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-9">
        <div class="card mb-20">
            <div class="card-body p-sm-20">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Político</dt>
                    <dd class="col-sm-9">@Model.Politico</dd>

                    <dt class="col-sm-3">Puesto</dt>
                    <dd class="col-sm-9">@Model.Puesto</dd>

                    <dt class="col-sm-3">Periodo</dt>
                    <dd class="col-sm-9">@meses[Model.Mes] @Model.Anio</dd>
                </dl>

                <div class="button-group d-flex pt-15">
                    <a asp-action="Edit" asp-route-id="@Model.IdCampana" class="btn btn-primary btn-default btn-squared px-30 me-15">Editar</a>
                    <a asp-action="Index" class="btn btn-light btn-default btn-squared px-30">Volver al listado</a>
                </div>
            </div>
        </div>
    </div>
</div>
