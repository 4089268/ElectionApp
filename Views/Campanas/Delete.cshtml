@model CatCampana
@{
    ViewData["Title"] = "Eliminar campaña";
    string[] meses = { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">¿Eliminar campaña?</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-9">
        <div class="card mb-30">
            <div class="card-body p-sm-30">
                <p>Esta acción no se puede deshacer. Si hay integrantes o eventos ligados a esta campaña, la eliminación fallará.</p>
                <dl class="row">
                    <dt class="col-sm-2">Descripción</dt>
                    <dd class="col-sm-10">@Model.Descripcion</dd>
                    <dt class="col-sm-2">Político</dt>
                    <dd class="col-sm-10">@Model.Politico</dd>
                    <dt class="col-sm-2">Periodo</dt>
                    <dd class="col-sm-10">@meses[Model.Mes] @Model.Anio</dd>
                </dl>

                <form asp-action="Delete" asp-route-id="@Model.IdCampana" method="post">
                    <div class="button-group d-flex pt-15">
                        <button type="submit" class="btn btn-danger btn-default btn-squared px-30 me-15">Sí, eliminar</button>
                        <a asp-action="Index" class="btn btn-light btn-default btn-squared px-30">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
