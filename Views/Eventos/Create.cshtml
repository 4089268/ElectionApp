@model ElectionApp.Models.Eventos.EventoFormViewModel
@{
    ViewData["Title"] = "Nuevo evento";
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">Nuevo evento</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-9">
        <div class="card mb-30">
            <div class="card-header border-bottom-0 p-sm-30">
                <h5 class="fw-500">Datos del evento</h5>
            </div>
            <div class="card-body pt-0 px-30 pb-35">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-15"></div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group mb-25">
                                <label asp-for="Descripcion"></label>
                                <input asp-for="Descripcion" class="form-control" required />
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label>Campaña</label>
                                <input class="form-control" value="@ViewBag.NombreCampanaActual" disabled />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Fecha"></label>
                                <input asp-for="Fecha" class="form-control" type="date" required />
                                <span asp-validation-for="Fecha" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Hora"></label>
                                <input asp-for="Hora" class="form-control" type="time" required />
                                <span asp-validation-for="Hora" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Lugar"></label>
                                <input asp-for="Lugar" class="form-control" placeholder="Salón, plaza, etc." />
                                <span asp-validation-for="Lugar" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="CostoEstimado"></label>
                                <input asp-for="CostoEstimado" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="CostoEstimado" class="text-danger"></span>
                                <small class="text-muted">El costo real se calcula solo, sumando los gastos que registres en el evento.</small>
                            </div>
                        </div>
                    </div>

                    <hr class="mb-25" />
                    <h6 class="fw-500 mb-20">Ubicación</h6>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group mb-25">
                                <label asp-for="Cp"></label>
                                <input asp-for="Cp" class="form-control" required />
                                <span asp-validation-for="Cp" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group mb-25">
                                <label asp-for="Colonia"></label>
                                <input asp-for="Colonia" class="form-control" required />
                                <span asp-validation-for="Colonia" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Localidad"></label>
                                <input asp-for="Localidad" class="form-control" />
                                <span asp-validation-for="Localidad" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="Municipio"></label>
                                <input asp-for="Municipio" class="form-control" required />
                                <span asp-validation-for="Municipio" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="Estado"></label>
                                <input asp-for="Estado" class="form-control" required />
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="button-group d-flex pt-25">
                        <button type="submit" class="btn btn-primary btn-default btn-squared px-30 me-15">Guardar</button>
                        <a asp-action="Index" class="btn btn-light btn-default btn-squared px-30">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
