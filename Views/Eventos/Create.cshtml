@model ElectionApp.Models.Eventos.EventoFormViewModel
@{
    ViewData["Title"] = "Nuevo evento";
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">Nuevo evento</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card mb-20">
            <div class="card-header border-bottom-0 p-sm-20">
                <h5 class="fw-500">Datos del evento</h5>
            </div>
            <div class="card-body pt-0 px-20 pb-25">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-15"></div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group mb-25">
                                <label asp-for="Descripcion"></label>
                                <input asp-for="Descripcion" class="form-control" required />
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label>Campaña</label>
                                <input class="form-control" value="@ViewBag.NombreCampanaActual" disabled />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Fecha"></label>
                                <input asp-for="Fecha" class="form-control" type="date" required />
                                <span asp-validation-for="Fecha" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Hora"></label>
                                <input asp-for="Hora" class="form-control" type="time" required />
                                <span asp-validation-for="Hora" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Lugar"></label>
                                <input asp-for="Lugar" class="form-control" placeholder="Salón, plaza, etc." />
                                <span asp-validation-for="Lugar" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="CostoEstimado"></label>
                                <input asp-for="CostoEstimado" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="CostoEstimado" class="text-danger"></span>
                                <small class="text-muted">El costo real se calcula solo, sumando los gastos que registres en el evento.</small>
                            </div>
                        </div>
                    </div>

                    <hr class="mb-25" />
                    <h6 class="fw-500 mb-20">Ubicación</h6>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group mb-25">
                                <label asp-for="Cp"></label>
                                <input asp-for="Cp" class="form-control" required />
                                <span asp-validation-for="Cp" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group mb-25">
                                <label asp-for="Colonia"></label>
                                <input asp-for="Colonia" class="form-control" required />
                                <span asp-validation-for="Colonia" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Localidad"></label>
                                <input asp-for="Localidad" class="form-control" />
                                <span asp-validation-for="Localidad" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="Municipio"></label>
                                <input asp-for="Municipio" class="form-control" required />
                                <span asp-validation-for="Municipio" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="Estado"></label>
                                <input asp-for="Estado" class="form-control" required />
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-25">
                        <label>Ubicación en el mapa</label>
                        <p class="text-muted mb-10">Haz clic en el mapa para marcar el pin exacto del evento (opcional: si no lo haces, se intenta calcular sola a partir de la dirección de arriba).</p>
                        <div id="mapa-evento" class="radius-xl" style="height: 400px;"></div>
                        <small class="text-muted d-block mt-10" id="mapa-evento-coords">Sin ubicación marcada todavía.</small>
                        <input type="hidden" id="input-latitud" name="Latitud" value="@Model.Latitud?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <input type="hidden" id="input-longitud" name="Longitud" value="@Model.Longitud?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                    </div>

                    <hr class="mb-25" />
                    <h6 class="fw-500 mb-20">Responsables / organizadores</h6>

                    <div class="form-group mb-25">
                        <label asp-for="IdsOrganizadores">Responsables u organizadores del evento</label>
                        <select asp-for="IdsOrganizadores" class="form-control select2-organizadores" asp-items="@(new MultiSelectList(ViewBag.OrganizadoresDisponibles, "IdIntegrante", "Etiqueta", Model.IdsOrganizadores))" multiple required></select>
                        <span asp-validation-for="IdsOrganizadores" class="text-danger"></span>
                        <small class="text-muted">Solo aparecen personas afiliadas a esta campaña con un rol distinto de Simpatizante (Jefe de Campaña, Jefe de Sección o Jefe de Manzana).</small>
                    </div>

                    <div class="button-group d-flex pt-25">
                        <button type="submit" class="btn btn-primary btn-default btn-squared px-30 me-15">Guardar</button>
                        <a asp-action="Index" class="btn btn-light btn-default btn-squared px-30">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            if (window.jQuery && jQuery.fn.select2) {
                jQuery('.select2-organizadores').select2({ width: '100%', placeholder: 'Selecciona uno o más responsables...' });
            }
        })();

        (function () {
            var contenedor = document.getElementById('mapa-evento');
            if (!contenedor) return;

            var inputLat = document.getElementById('input-latitud');
            var inputLng = document.getElementById('input-longitud');
            var texto = document.getElementById('mapa-evento-coords');

            var latInicial = parseFloat(inputLat.value);
            var lngInicial = parseFloat(inputLng.value);
            var tieneCoords = !isNaN(latInicial) && !isNaN(lngInicial);

            // Centro por defecto: Ciudad Victoria, Tamaulipas (donde está
            // enfocada la operación actual de la campaña).
            var centro = tieneCoords ? [latInicial, lngInicial] : [23.7369, -99.1411];
            var zoom = tieneCoords ? 15 : 8;

            var mapa = L.map(contenedor).setView(centro, zoom);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: '&copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a> contributors'
            }).addTo(mapa);

            var marcador = null;

            function actualizarCoords(lat, lng) {
                inputLat.value = lat;
                inputLng.value = lng;
                texto.textContent = 'Lat: ' + lat.toFixed(6) + ', Lng: ' + lng.toFixed(6);
            }

            function ubicarPin(lat, lng) {
                if (marcador) {
                    marcador.setLatLng([lat, lng]);
                } else {
                    marcador = L.marker([lat, lng], { draggable: true }).addTo(mapa);
                    marcador.on('dragend', function () {
                        var pos = marcador.getLatLng();
                        actualizarCoords(pos.lat, pos.lng);
                    });
                }
                actualizarCoords(lat, lng);
            }

            if (tieneCoords) {
                ubicarPin(latInicial, lngInicial);
            }

            mapa.on('click', function (e) {
                ubicarPin(e.latlng.lat, e.latlng.lng);
            });
        })();
    </script>
}
