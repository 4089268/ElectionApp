@model OprEvento
@{
    ViewData["Title"] = "Detalle del evento";
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">@Model.Descripcion</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card mb-30">
            <div class="card-body p-sm-30">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Campaña</dt>
                    <dd class="col-sm-9">@Model.Campana.Descripcion</dd>

                    <dt class="col-sm-3">Fecha / Hora</dt>
                    <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy") @Model.Hora.ToString("HH:mm")</dd>

                    <dt class="col-sm-3">Lugar</dt>
                    <dd class="col-sm-9">@Model.Lugar</dd>

                    <dt class="col-sm-3">Ubicación</dt>
                    <dd class="col-sm-9">
                        @($"{Model.Ubicacion.Colonia}, {Model.Ubicacion.Municipio}, {Model.Ubicacion.Estado} CP {Model.Ubicacion.Cp}")
                        @if (!string.IsNullOrWhiteSpace(Model.Ubicacion.Localidad))
                        {
                            @($" ({Model.Ubicacion.Localidad})")
                        }
                    </dd>

                    <dt class="col-sm-3">Costo estimado</dt>
                    <dd class="col-sm-9">@(Model.CostoEstimado?.ToString("C2"))</dd>

                    <dt class="col-sm-3">Costo real (gastos registrados)</dt>
                    <dd class="col-sm-9">@(Model.CostoReal?.ToString("C2") ?? (0m).ToString("C2"))</dd>
                </dl>

                <div class="button-group d-flex pt-15">
                    <a asp-action="Edit" asp-route-id="@Model.IdEvento" class="btn btn-primary btn-default btn-squared px-30 me-15">Editar</a>
                    <a asp-action="Index" class="btn btn-light btn-default btn-squared px-30">Volver al listado</a>
                </div>
            </div>
        </div>

        <div class="card mb-30">
            <div class="card-header border-bottom-0 p-sm-30">
                <h5 class="fw-500">Gastos del evento</h5>
            </div>
            <div class="card-body pt-0 px-30 pb-35">
                @{
                    var totalGastosEvento = Model.Gastos.Sum(g => g.Monto);
                    var diferenciaEvento = totalGastosEvento - (Model.CostoEstimado ?? 0);
                }
                <dl class="row mb-0">
                    <dt class="col-sm-4">Costo estimado</dt>
                    <dd class="col-sm-8 text-sm-end">@((Model.CostoEstimado ?? 0).ToString("C2"))</dd>

                    <dt class="col-sm-4">Total registrado</dt>
                    <dd class="col-sm-8 text-sm-end">@totalGastosEvento.ToString("C2")</dd>

                    <dt class="col-sm-4">Diferencia</dt>
                    <dd class="col-sm-8 text-sm-end @(diferenciaEvento > 0 ? "text-danger" : "text-success")">@diferenciaEvento.ToString("C2")</dd>
                </dl>

                @if (TempData["GastoError"] is not null)
                {
                    <div class="alert alert-danger mt-15 mb-0">@TempData["GastoError"]</div>
                }

                <hr class="my-20" />

                @if (Model.Gastos.Any())
                {
                    <div class="table-responsive mb-20">
                        <table class="table mb-0 table-borderless">
                            <thead>
                                <tr class="userDatatable-header">
                                    <th><span class="userDatatable-title">Concepto</span></th>
                                    <th><span class="userDatatable-title text-end">Costo unitario</span></th>
                                    <th><span class="userDatatable-title text-end">Cantidad</span></th>
                                    <th><span class="userDatatable-title text-end">Total</span></th>
                                    <th><span class="userDatatable-title">Fecha</span></th>
                                    <th><span class="userDatatable-title">Registrado por</span></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gasto in Model.Gastos.OrderByDescending(g => g.FechaRegistro))
                                {
                                    <tr>
                                        <td><div class="userDatatable-content">@gasto.Concepto</div></td>
                                        <td class="text-end"><div class="userDatatable-content">@gasto.CostoUnitario.ToString("C2")</div></td>
                                        <td class="text-end"><div class="userDatatable-content">@gasto.Cantidad</div></td>
                                        <td class="text-end"><div class="userDatatable-content">@gasto.Monto.ToString("C2")</div></td>
                                        <td><div class="userDatatable-content">@gasto.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div></td>
                                        <td><div class="userDatatable-content">@gasto.UsuarioRegistro.UsuarioNombre</div></td>
                                        <td class="text-end">
                                            <form asp-controller="GastosEvento" asp-action="Delete" asp-route-id="@gasto.IdGasto" method="post" onsubmit="return confirm('¿Eliminar este gasto?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="uil uil-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="mb-20">Todavía no hay gastos registrados para este evento.</p>
                }

                <form asp-controller="GastosEvento" asp-action="Create" method="post">
                    <input type="hidden" name="idEvento" value="@Model.IdEvento" />
                    <div class="row align-items-end">
                        <div class="col-md-4">
                            <div class="form-group mb-15 mb-md-0">
                                <label>Concepto</label>
                                <input type="text" name="concepto" class="form-control" placeholder="Renta de local, transporte, comida..." required />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group mb-15 mb-md-0">
                                <label>Costo unitario</label>
                                <input type="number" name="costoUnitario" class="form-control gasto-costo-unitario" step="0.01" min="0.01" required />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group mb-15 mb-md-0">
                                <label>Cantidad</label>
                                <input type="number" name="cantidad" class="form-control gasto-cantidad" step="1" min="1" value="1" required />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group mb-15 mb-md-0">
                                <label>Total</label>
                                <input type="text" class="form-control gasto-total" value="$0.00" disabled />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary btn-default btn-squared w-100">Registrar gasto</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var costoUnitario = document.querySelector('.gasto-costo-unitario');
            var cantidad = document.querySelector('.gasto-cantidad');
            var total = document.querySelector('.gasto-total');
            if (!costoUnitario || !cantidad || !total) return;

            function actualizarTotal() {
                var t = (parseFloat(costoUnitario.value) || 0) * (parseInt(cantidad.value, 10) || 0);
                total.value = t.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
            }

            costoUnitario.addEventListener('input', actualizarTotal);
            cantidad.addEventListener('input', actualizarTotal);
        })();
    </script>
}
