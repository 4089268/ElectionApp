@model IEnumerable<OprGastoApoyo>
@{
    ViewData["Title"] = "Apoyos y donaciones";
}

<div class="breadcrumb-main user-member justify-content-sm-between">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center user-member__title justify-content-center me-sm-25">
            <h4 class="text-capitalize fw-500 breadcrumb-title">Apoyos y donaciones</h4>
            <span class="sub-title ms-sm-25 ps-sm-25">@Model.Count() en total</span>
        </div>
        <form method="get" class="d-flex align-items-center user-member__form my-sm-0 my-2">
            <img src="~/theme/img/svg/search.svg" alt="search" class="svg">
            <input type="text" name="filtro" value="@ViewBag.Filtro" class="form-control me-sm-2 border-0 box-shadow-none" placeholder="Buscar por integrante, CURP, evento o concepto">
        </form>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        @if (TempData["GastoError"] is not null)
        {
            <div class="alert alert-danger mb-15">@TempData["GastoError"]</div>
        }

        <div class="userDatatable global-shadow border-light-0 p-30 bg-white radius-xl w-100 mb-30">
            <div class="d-flex justify-content-between align-items-center mb-15">
                <h6 class="mb-0">Historial de apoyos</h6>
                <div class="d-flex align-items-center">
                    <span class="fw-500 me-20">Total otorgado: @(((decimal)ViewBag.TotalApoyos).ToString("C2"))</span>
                    <a asp-controller="GastosApoyo" asp-action="Create" asp-route-returnUrl="@Url.Action("Index", new { filtro = ViewBag.Filtro })" class="btn btn-primary btn-default btn-squared px-25">
                        <i class="uil uil-plus"></i> Registrar apoyo
                    </a>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table mb-0 table-borderless">
                    <thead>
                        <tr class="userDatatable-header">
                            <th><span class="userDatatable-title">Integrante</span></th>
                            <th><span class="userDatatable-title">Evento</span></th>
                            <th><span class="userDatatable-title">Concepto</span></th>
                            <th><span class="userDatatable-title text-end">Costo unitario</span></th>
                            <th><span class="userDatatable-title text-end">Cantidad</span></th>
                            <th><span class="userDatatable-title text-end">Total</span></th>
                            <th><span class="userDatatable-title">Fecha</span></th>
                            <th><span class="userDatatable-title">Registrado por</span></th>
                            <th><span class="userDatatable-title">Evidencia</span></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gasto in Model)
                        {
                            <tr>
                                <td>
                                    <div class="userDatatable-inline-title">
                                        @if (gasto.IntegranteCampana is not null)
                                        {
                                            <a asp-controller="Integrantes" asp-action="Details" asp-route-id="@gasto.IntegranteCampana.IdIntegrante" class="text-dark fw-500">
                                                @gasto.IntegranteCampana.Integrante.NombreCompleto
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">— (ayuda general)</span>
                                        }
                                    </div>
                                </td>
                                <td><div class="userDatatable-content">@(gasto.Evento?.Descripcion ?? "—")</div></td>
                                <td><div class="userDatatable-content">@gasto.Concepto</div></td>
                                <td class="text-end"><div class="userDatatable-content">@gasto.CostoUnitario.ToString("C2")</div></td>
                                <td class="text-end"><div class="userDatatable-content">@gasto.Cantidad</div></td>
                                <td class="text-end"><div class="userDatatable-content">@gasto.Monto.ToString("C2")</div></td>
                                <td><div class="userDatatable-content">@gasto.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div></td>
                                <td><div class="userDatatable-content">@gasto.UsuarioRegistro.UsuarioNombre</div></td>
                                <td>
                                    @if (gasto.Documentos.Any())
                                    {
                                        <a asp-controller="Documentos" asp-action="Descargar" asp-route-id="@gasto.Documentos.First().IdDocumento" target="_blank" title="Ver evidencia">
                                            <i class="uil uil-paperclip"></i> @gasto.Documentos.Count()
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <form asp-controller="GastosApoyo" asp-action="Delete" asp-route-id="@gasto.IdGastoApoyo" method="post" onsubmit="return confirm('¿Eliminar este apoyo?');">
                                        <input type="hidden" name="returnUrl" value="@Url.Action("Index", new { filtro = ViewBag.Filtro })" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="uil uil-trash-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Any())
                {
                    <p class="mb-0 mt-15">Todavía no hay apoyos registrados en esta campaña.</p>
                }
            </div>
        </div>
    </div>
</div>
