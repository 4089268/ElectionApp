@model CatIntegrante
@{
    ViewData["Title"] = "Detalle del integrante";
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">@Model.NombreCompleto</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-9">
        <div class="card mb-30">
            <div class="card-body p-sm-30">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Ocupación</dt>
                    <dd class="col-sm-9">@Model.Ocupacion</dd>

                    <dt class="col-sm-3">Edad</dt>
                    <dd class="col-sm-9">@Model.Edad</dd>

                    <dt class="col-sm-3">Estado civil</dt>
                    <dd class="col-sm-9">@Model.EstadoCivil?.Descripcion</dd>

                    <dt class="col-sm-3">Hijos mayores de edad</dt>
                    <dd class="col-sm-9">@Model.HijosMayoresEdad</dd>

                    <dt class="col-sm-3">Sección</dt>
                    <dd class="col-sm-9">@Model.Seccion</dd>

                    <dt class="col-sm-3">Clave de elector</dt>
                    <dd class="col-sm-9">@Model.ClaveElector</dd>

                    <dt class="col-sm-3">Celular / WhatsApp</dt>
                    <dd class="col-sm-9">@Model.Celular / @Model.Whatsapp</dd>

                    <dt class="col-sm-3">Facebook</dt>
                    <dd class="col-sm-9">@Model.Facebook</dd>

                    <dt class="col-sm-3">Domicilio</dt>
                    <dd class="col-sm-9">
                        @if (Model.Domicilio is not null)
                        {
                            @($"{Model.Domicilio.Calle} {Model.Domicilio.Numero}, {Model.Domicilio.Colonia}, {Model.Domicilio.Ciudad}, {Model.Domicilio.Estado} CP {Model.Domicilio.Cp}")
                        }
                    </dd>

                    <dt class="col-sm-3">Rol</dt>
                    <dd class="col-sm-9">@Model.Rol.Descripcion</dd>

                    <dt class="col-sm-3">Campaña</dt>
                    <dd class="col-sm-9">@Model.Campana.Descripcion</dd>

                    <dt class="col-sm-3">Reporta a</dt>
                    <dd class="col-sm-9">@Model.IntegranteSuperior?.NombreCompleto</dd>

                    <dt class="col-sm-3">Fecha de registro</dt>
                    <dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>

                <div class="button-group d-flex pt-15">
                    <a asp-action="Edit" asp-route-id="@Model.IdIntegrante" class="btn btn-primary btn-default btn-squared px-30 me-15">Editar</a>
                    <a asp-action="Index" class="btn btn-light btn-default btn-squared px-30">Volver al listado</a>
                </div>
            </div>
        </div>
    </div>
</div>
