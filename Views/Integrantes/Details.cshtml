@model CatIntegranteCampana
@{
    ViewData["Title"] = "Detalle del integrante";
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">@Model.Integrante.NombreCompleto</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card mb-30">
            <div class="card-body p-sm-30">
                <dl class="row mb-0">
                    <dt class="col-sm-3">CURP</dt>
                    <dd class="col-sm-9">@Model.Integrante.Curp</dd>

                    <dt class="col-sm-3">Ocupación</dt>
                    <dd class="col-sm-9">@Model.Integrante.Ocupacion</dd>

                    <dt class="col-sm-3">Edad</dt>
                    <dd class="col-sm-9">@Model.Integrante.Edad</dd>

                    <dt class="col-sm-3">Estado civil</dt>
                    <dd class="col-sm-9">@Model.Integrante.EstadoCivil?.Descripcion</dd>

                    <dt class="col-sm-3">Hijos mayores de edad</dt>
                    <dd class="col-sm-9">@Model.Integrante.HijosMayoresEdad</dd>

                    <dt class="col-sm-3">Sección</dt>
                    <dd class="col-sm-9">@Model.Integrante.Seccion</dd>

                    <dt class="col-sm-3">Clave de elector</dt>
                    <dd class="col-sm-9">@Model.Integrante.ClaveElector</dd>

                    <dt class="col-sm-3">Celular / WhatsApp</dt>
                    <dd class="col-sm-9">@Model.Integrante.Celular / @Model.Integrante.Whatsapp</dd>

                    <dt class="col-sm-3">Facebook</dt>
                    <dd class="col-sm-9">@Model.Integrante.Facebook</dd>

                    <dt class="col-sm-3">Domicilio</dt>
                    <dd class="col-sm-9">
                        @if (Model.Integrante.Domicilio is not null)
                        {
                            @($"{Model.Integrante.Domicilio.Calle} {Model.Integrante.Domicilio.Numero}, {Model.Integrante.Domicilio.Colonia}, {Model.Integrante.Domicilio.Ciudad}, {Model.Integrante.Domicilio.Estado} CP {Model.Integrante.Domicilio.Cp}")
                        }
                    </dd>

                    <dt class="col-sm-3">Rol en esta campaña</dt>
                    <dd class="col-sm-9">@Model.Rol.Descripcion</dd>

                    <dt class="col-sm-3">Afiliado desde</dt>
                    <dd class="col-sm-9">@Model.FechaAfiliacion.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-3">Registrado en el padrón desde</dt>
                    <dd class="col-sm-9">@Model.Integrante.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>

                <div class="button-group d-flex pt-15">
                    <a asp-action="Edit" asp-route-id="@Model.IdIntegrante" class="btn btn-primary btn-default btn-squared px-30 me-15">Editar</a>
                    <a asp-action="Index" class="btn btn-light btn-default btn-squared px-30">Volver al listado</a>
                </div>
            </div>
        </div>

        <div class="card mb-30">
            <div class="card-header border-bottom-0 p-sm-30">
                <h5 class="fw-500">Apoyos y donaciones otorgados</h5>
            </div>
            <div class="card-body pt-0 px-30 pb-35">
                @{
                    var totalApoyos = Model.GastosApoyo.Sum(g => g.Monto);
                }
                <div class="d-flex justify-content-between fw-500 mb-15">
                    <span>Total otorgado en esta campaña</span>
                    <span>@totalApoyos.ToString("C2")</span>
                </div>

                @if (TempData["GastoError"] is not null)
                {
                    <div class="alert alert-danger mb-15">@TempData["GastoError"]</div>
                }

                @if (Model.GastosApoyo.Any())
                {
                    <div class="table-responsive mb-20">
                        <table class="table mb-0 table-borderless">
                            <thead>
                                <tr class="userDatatable-header">
                                    <th><span class="userDatatable-title">Concepto</span></th>
                                    <th><span class="userDatatable-title text-end">Costo unitario</span></th>
                                    <th><span class="userDatatable-title text-end">Cantidad</span></th>
                                    <th><span class="userDatatable-title text-end">Total</span></th>
                                    <th><span class="userDatatable-title">Evento</span></th>
                                    <th><span class="userDatatable-title">Fecha</span></th>
                                    <th><span class="userDatatable-title">Registrado por</span></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gasto in Model.GastosApoyo.OrderByDescending(g => g.FechaRegistro))
                                {
                                    <tr>
                                        <td><div class="userDatatable-content">@gasto.Concepto</div></td>
                                        <td class="text-end"><div class="userDatatable-content">@gasto.CostoUnitario.ToString("C2")</div></td>
                                        <td class="text-end"><div class="userDatatable-content">@gasto.Cantidad</div></td>
                                        <td class="text-end"><div class="userDatatable-content">@gasto.Monto.ToString("C2")</div></td>
                                        <td><div class="userDatatable-content">@(gasto.Evento?.Descripcion ?? "—")</div></td>
                                        <td><div class="userDatatable-content">@gasto.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div></td>
                                        <td><div class="userDatatable-content">@gasto.UsuarioRegistro.UsuarioNombre</div></td>
                                        <td class="text-end">
                                            <form asp-controller="GastosApoyo" asp-action="Delete" asp-route-id="@gasto.IdGastoApoyo" method="post" onsubmit="return confirm('¿Eliminar este apoyo?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="uil uil-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="mb-20">Todavía no se han registrado apoyos para esta persona en esta campaña.</p>
                }

                <form asp-controller="GastosApoyo" asp-action="Create" method="post">
                    <input type="hidden" name="idIntegranteCampana" value="@Model.IdIntegranteCampana" />
                    <div class="row align-items-end">
                        <div class="col-md-3">
                            <div class="form-group mb-15 mb-md-0">
                                <label>Concepto</label>
                                <input type="text" name="concepto" class="form-control" placeholder="Despensa, apoyo económico, medicamento..." required />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group mb-15 mb-md-0">
                                <label>Evento (opcional)</label>
                                <select name="idEvento" class="form-control">
                                    <option value="">Ninguno / ayuda general</option>
                                    @foreach (var evento in ViewBag.Eventos)
                                    {
                                        <option value="@evento.IdEvento">@evento.Descripcion</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group mb-15 mb-md-0">
                                <label>Costo unitario</label>
                                <input type="number" name="costoUnitario" class="form-control gasto-costo-unitario" step="0.01" min="0.01" required />
                            </div>
                        </div>
                        <div class="col-md-1">
                            <div class="form-group mb-15 mb-md-0">
                                <label>Cant.</label>
                                <input type="number" name="cantidad" class="form-control gasto-cantidad" step="1" min="1" value="1" required />
                            </div>
                        </div>
                        <div class="col-md-2 mt-15">
                            <div class="form-group mb-15 mb-md-0">
                                <label>Total</label>
                                <input type="text" class="form-control gasto-total" value="$0.00" disabled />
                            </div>
                        </div>
                        <div class="col-md-1 mt-15">
                            <button type="submit" class="btn btn-primary btn-default btn-squared w-100">Registrar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var costoUnitario = document.querySelector('.gasto-costo-unitario');
            var cantidad = document.querySelector('.gasto-cantidad');
            var total = document.querySelector('.gasto-total');
            if (!costoUnitario || !cantidad || !total) return;

            function actualizarTotal() {
                var t = (parseFloat(costoUnitario.value) || 0) * (parseInt(cantidad.value, 10) || 0);
                total.value = t.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
            }

            costoUnitario.addEventListener('input', actualizarTotal);
            cantidad.addEventListener('input', actualizarTotal);
        })();
    </script>
}
