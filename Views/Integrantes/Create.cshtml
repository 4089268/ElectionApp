@model CatIntegrante
@{
    ViewData["Title"] = "Nuevo integrante";
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">Nuevo integrante</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-9">
        <div class="card mb-30">
            <div class="card-header border-bottom-0 p-sm-30">
                <h5 class="fw-500">Datos del integrante</h5>
            </div>
            <div class="card-body pt-0 px-30 pb-35">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-15"></div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Nombre"></label>
                                <input asp-for="Nombre" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="ApellidoPaterno"></label>
                                <input asp-for="ApellidoPaterno" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="ApellidoMaterno"></label>
                                <input asp-for="ApellidoMaterno" class="form-control" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Edad"></label>
                                <input asp-for="Edad" class="form-control" type="number" min="0" max="120" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="Ocupacion"></label>
                                <input asp-for="Ocupacion" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="IdEstadoCivil">Estado civil</label>
                                <select asp-for="IdEstadoCivil" class="form-control" asp-items="@(new SelectList(ViewBag.EstadosCiviles, "IdEstadoCivil", "Descripcion"))">
                                    <option value="">-- Selecciona --</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="HijosMayoresEdad"></label>
                                <input asp-for="HijosMayoresEdad" class="form-control" type="number" min="0" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Seccion"></label>
                                <input asp-for="Seccion" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="ClaveElector"></label>
                                <input asp-for="ClaveElector" class="form-control" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Celular"></label>
                                <input asp-for="Celular" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Whatsapp"></label>
                                <input asp-for="Whatsapp" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-25">
                                <label asp-for="Facebook"></label>
                                <input asp-for="Facebook" class="form-control" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="IdRol">Rol</label>
                                <select asp-for="IdRol" class="form-control" asp-items="@(new SelectList(ViewBag.Roles, "IdRol", "Descripcion"))" required>
                                    <option value="">-- Selecciona --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="IdCampana">Campaña</label>
                                <select asp-for="IdCampana" class="form-control" asp-items="@(new SelectList(ViewBag.Campanas, "IdCampana", "Descripcion"))" required>
                                    <option value="">-- Selecciona --</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-25">
                                <label asp-for="IdDomicilio">Domicilio</label>
                                <select asp-for="IdDomicilio" class="form-control" asp-items="@(new SelectList(ViewBag.Domicilios, "IdDomicilio", "Calle"))">
                                    <option value="">-- Sin domicilio registrado --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="button-group d-flex pt-25">
                        <button type="submit" class="btn btn-primary btn-default btn-squared px-30 me-15">Guardar</button>
                        <a asp-action="Index" class="btn btn-light btn-default btn-squared px-30">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
