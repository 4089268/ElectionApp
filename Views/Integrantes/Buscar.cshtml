@{
    int? idEvento = ViewBag.IdEvento as int?;
    ViewData["Title"] = idEvento.HasValue ? "Registrar participante" : "Agregar integrante";
}

<div class="breadcrumb-main">
    <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
        <div class="d-flex align-items-center">
            <h4 class="text-capitalize fw-500 breadcrumb-title">@ViewData["Title"]</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card mb-20">
            <div class="card-header border-bottom-0 p-sm-20">
                <h5 class="fw-500">Buscar por CURP o Clave de Elector (INE)</h5>
            </div>
            <div class="card-body pt-0 px-20 pb-25">
                <p class="mb-20">
                    El padrón de integrantes es global: primero buscamos por CURP o Clave de
                    Elector para no duplicar a una persona que ya está registrada
                    @(idEvento.HasValue ? "." : "en otra campaña.")
                </p>
                <form asp-action="Buscar" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-15"></div>
                    <input type="hidden" name="idEvento" value="@idEvento" />
                    <div class="form-group mb-25">
                        <label for="curp">CURP o Clave de Elector</label>
                        <input type="text" id="curp" name="curp" class="form-control text-uppercase" maxlength="18" required autofocus />
                    </div>
                    <div class="button-group d-flex pt-10">
                        <button type="submit" class="btn btn-primary btn-default btn-squared px-30 me-15">Buscar</button>
                        @if (idEvento.HasValue)
                        {
                            <a asp-controller="Eventos" asp-action="Details" asp-route-id="@idEvento" class="btn btn-light btn-default btn-squared px-30">Cancelar</a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-light btn-default btn-squared px-30">Cancelar</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
