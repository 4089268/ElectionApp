@model ElectionApp.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!doctype html>
<html lang="es" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión - ElectionApp</title>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/bootstrap/bootstrap.css">
    <link rel="stylesheet" href="~/theme/assets/vendor_assets/css/line-awesome.min.css">
    <link rel="stylesheet" href="~/theme/style.css">
    <link rel="icon" type="image/png" sizes="16x16" href="~/theme/img/favicon.png">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
</head>
<body class="loaded">
    <main class="main-content">
        <div class="admin">
            <div class="container-fluid">
                <div class="row justify-content-center">
                    <div class="col-xxl-3 col-xl-4 col-md-6 col-sm-8">
                        <div class="edit-profile">
                            <div class="edit-profile__logos">
                                <img class="dark" src="~/theme/img/logo.png" alt="ElectionApp">
                                <img class="light" src="~/theme/img/logo.png" alt="ElectionApp">
                            </div>
                            <div class="card border-0">
                                <div class="card-header">
                                    <div class="edit-profile__title">
                                        <h6>Iniciar sesión en ElectionApp</h6>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="edit-profile__body">
                                        <div asp-validation-summary="ModelOnly" class="text-danger mb-15"></div>
                                        <form asp-controller="Account" asp-action="Login" method="post">
                                            <input type="hidden" asp-for="ReturnUrl" />
                                            <div class="form-group mb-25">
                                                <label asp-for="Usuario"></label>
                                                <input asp-for="Usuario" class="form-control" placeholder="usuario" autofocus />
                                                <span asp-validation-for="Usuario" class="text-danger"></span>
                                            </div>
                                            <div class="form-group mb-15">
                                                <label asp-for="Password"></label>
                                                <input asp-for="Password" class="form-control" placeholder="Contraseña" />
                                                <span asp-validation-for="Password" class="text-danger"></span>
                                            </div>
                                            <div class="admin__button-group button-group d-flex pt-1 justify-content-md-start justify-content-center">
                                                <button type="submit" class="btn btn-primary btn-default w-100 btn-squared text-capitalize lh-normal px-50 signIn-createBtn">
                                                    Entrar
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script src="~/theme/assets/vendor_assets/js/jquery/jquery-3.5.1.min.js"></script>
    <script src="~/theme/assets/vendor_assets/js/bootstrap/popper.js"></script>
    <script src="~/theme/assets/vendor_assets/js/bootstrap/bootstrap.min.js"></script>
</body>
</html>
